# Copy to .env (git-ignored). scripts/setup-external-storage.sh writes this for you
# after you confirm the real mount path — do not guess it.

# Root of the DayOS asset tree on the external drive. Must be under /Volumes/<drive>/.
DAYOS_ASSETS_ROOT=/Volumes/<EXTERNAL_DRIVE_NAME>/dayos-assets

# The variables below are derived from DAYOS_ASSETS_ROOT by scripts/lib/storage-env.sh
# and scripts/dayos_storage.py at runtime. They are listed for reference only;
# do NOT export them globally in ~/.zshrc (that would affect other projects).
#
# HF_HOME=$DAYOS_ASSETS_ROOT/cache/huggingface
# HF_HUB_CACHE=$DAYOS_ASSETS_ROOT/cache/huggingface/hub
# HF_XET_CACHE=$DAYOS_ASSETS_ROOT/cache/huggingface/xet
# HF_ASSETS_CACHE=$DAYOS_ASSETS_ROOT/cache/huggingface/assets
# HF_TOKEN_PATH=~/.cache/huggingface/token        (token stays on the Mac)
# TORCH_HOME=$DAYOS_ASSETS_ROOT/cache/torch
# XDG_CACHE_HOME=$DAYOS_ASSETS_ROOT/cache/xdg
# PIP_CACHE_DIR=$DAYOS_ASSETS_ROOT/cache/pip
# UV_CACHE_DIR=$DAYOS_ASSETS_ROOT/cache/uv
# OLLAMA_MODELS=$DAYOS_ASSETS_ROOT/models/ollama  (read by `ollama serve`, not the client)
# TMPDIR=$DAYOS_ASSETS_ROOT/tmp/

# API keys (never commit real values)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
